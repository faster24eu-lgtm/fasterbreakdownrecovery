      {
        "@type": "Question",
        "name": "Can you take my car to a garage?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. To a garage, your home, a dealer or any other address you choose, locally or long distance." }
      },
      {
        "@type": "Question",
        "name": "Do you recover vans and light commercial vehicles?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Tell us the size of the van and roughly how heavily it's loaded, so the right recovery vehicle is sent." }
      },
      {
        "@type": "Question",
        "name": "Can you help at night and at weekends?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Our phone and WhatsApp are answered 24 hours a day, every day, including bank holidays." }
      },
      {
        "@type": "Question",
        "name": "What's the difference between breakdown recovery and roadside assistance?",
        "acceptedAnswer": { "@type": "Answer", "text": "Roadside assistance covers problems that can often be fixed on the spot, like a flat battery or a puncture. Breakdown recovery is for when the vehicle can't safely be driven and needs to be taken somewhere else. Tell us what's happened and we'll advise which you need." }
